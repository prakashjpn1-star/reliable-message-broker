{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/reliable-message-broker/schemas/consumer-registration.schema.json",
  "title": "Fresh consumer instance registration",
  "type": "object",
  "properties": {
    "consumerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "queueIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "consumerId",
    "queueIds",
    "capacity"
  ],
  "additionalProperties": false
}
