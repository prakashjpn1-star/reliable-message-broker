{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/reliable-message-broker/schemas/route-request.schema.json",
  "title": "Versioned exact or fan-out route",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "const": "EXACT_KEY"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "routingKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "queueId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "routingKey",
              "queueId"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "name",
        "mode",
        "bindings"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "const": "FAN_OUT"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "queueId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "queueId"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "name",
        "mode",
        "bindings"
      ],
      "additionalProperties": false
    }
  ]
}
